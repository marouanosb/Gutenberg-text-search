[Unit]
Description=Gutenberg-text-search auto-deploy service
Wants=gts-deploy.timer

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/gts-deploy
ExecStart=/usr/bin/env bash -lc "REPO_DIR=${REPO_DIR:-$HOME/Gutenberg-text-search} REPO_URL=${REPO_URL:-https://github.com/marouanosb/Gutenberg-text-search.git} bash \"$REPO_DIR/scripts/auto-deploy.sh\""
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
