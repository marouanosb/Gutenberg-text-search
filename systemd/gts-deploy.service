[Unit]
Description=Gutenberg-text-search auto-deploy service
Wants=gts-deploy.timer

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
EnvironmentFile=-/etc/default/gts-deploy
WorkingDirectory=/home/ubuntu/Gutenberg-text-search
ExecStart=/usr/bin/env bash -lc "REPO_DIR=${REPO_DIR:-/home/ubuntu/Gutenberg-text-search} REPO_URL=${REPO_URL:-https://github.com/marouanosb/Gutenberg-text-search.git} bash ./scripts/auto-deploy.sh"
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
